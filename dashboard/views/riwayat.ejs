<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Riwayat Chat - Dashboard Chatbot Desa</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <% if (admin.adminId) { %>
    <!-- Navbar -->
    <nav class="navbar">
      <div class="container">
        <div class="navbar-brand">
          <h1>🏛️ Dashboard Chatbot Desa</h1>
        </div>
        <ul class="navbar-menu">
          <li><a href="/">Dashboard</a></li>
          <li><a href="/layanan">Layanan</a></li>
          <li><a href="/riwayat" class="active">Riwayat Chat</a></li>
          <li><a href="/statistik">Statistik</a></li>
        </ul>
        <div class="navbar-user">
          <span>👤 <%= admin.adminNama || admin.adminUsername %></span>
          <a href="/logout" class="btn-logout">Logout</a>
        </div>
      </div>
    </nav>
    <% } %>

      <main class="main-content">
        <div class="container">
          <h2>Riwayat Percakapan</h2>
          <p class="subtitle">Log semua percakapan antara warga dan chatbot</p>

          <!-- Filter -->
          <div class="filter-box">
            <form action="/riwayat" method="GET" class="filter-form">
              <div class="form-row">
                <div class="form-group">
                  <label for="tanggal_mulai">Tanggal Mulai</label>
                  <input type="date" id="tanggal_mulai" name="tanggal_mulai" value="<%= filter.tanggalMulai %>">
                </div>

                <div class="form-group">
                  <label for="tanggal_selesai">Tanggal Selesai</label>
                  <input type="date" id="tanggal_selesai" name="tanggal_selesai" value="<%= filter.tanggalSelesai %>">
                </div>

                <div class="form-group">
                  <label>&nbsp;</label>
                  <button type="submit" class="btn btn-primary">🔍 Filter</button>
                  <a href="/riwayat" class="btn btn-secondary">Reset</a>
                </div>
              </div>
            </form>
          </div>

          <!-- Info -->
          <div class="info-box">
            <p>📊 Total: <strong>
                <%= pagination.total %>
              </strong> percakapan</p>
          </div>

          <!-- Tabel Riwayat -->
          <% if (riwayatList.length> 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th width="15%">Waktu</th>
                    <th width="12%">Nomor WA</th>
                    <th width="25%">Pesan Masuk</th>
                    <th width="30%">Balasan Bot</th>
                    <th width="18%">Layanan</th>
                  </tr>
                </thead>
                <tbody>
                  <% riwayatList.forEach(chat=> { %>
                    <tr>
                      <td>
                        <%= new Date(chat.waktu).toLocaleString('id-ID', { day: '2-digit' , month: 'short' ,
                          year: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                      </td>
                      <td class="text-monospace">
                        <%= chat.nomor_wa.replace('@s.whatsapp.net', '' ).substring(0, 12) %>...
                      </td>
                      <td class="text-wrap-cell">
                        <%= chat.pesan_masuk.substring(0, 60) %>
                          <%= chat.pesan_masuk.length> 60 ? '...' : '' %>
                      </td>
                      <td class="text-wrap-cell">
                        <%= chat.balasan_bot.substring(0, 80) %>
                          <%= chat.balasan_bot.length> 80 ? '...' : '' %>
                      </td>
                      <td>
                        <% if (chat.layanan_nama) { %>
                          <span class="badge">
                            <%= chat.layanan_nama %>
                          </span>
                          <% } else { %>
                            <span class="text-muted">Menu/Error</span>
                            <% } %>
                      </td>
                    </tr>
                    <% }); %>
                </tbody>
              </table>
            </div>

            <!-- Pagination -->
            <% if (pagination.totalPages> 1) { %>
              <div class="pagination">
                <% if (pagination.page> 1) { %>
                  <a href="/riwayat?page=<%= pagination.page - 1 %><%= filter.tanggalMulai ? '&tanggal_mulai=' + filter.tanggalMulai : '' %><%= filter.tanggalSelesai ? '&tanggal_selesai=' + filter.tanggalSelesai : '' %>"
                    class="btn btn-sm btn-secondary">← Sebelumnya</a>
                  <% } %>

                    <span class="pagination-info">
                      Halaman <%= pagination.page %> dari <%= pagination.totalPages %>
                    </span>

                    <% if (pagination.page < pagination.totalPages) { %>
                      <a href="/riwayat?page=<%= pagination.page + 1 %><%= filter.tanggalMulai ? '&tanggal_mulai=' + filter.tanggalMulai : '' %><%= filter.tanggalSelesai ? '&tanggal_selesai=' + filter.tanggalSelesai : '' %>"
                        class="btn btn-sm btn-secondary">Selanjutnya →</a>
                      <% } %>
              </div>
              <% } %>

                <% } else { %>
                  <div class="empty-state">
                    <p>💬 Belum ada riwayat percakapan.</p>
                    <% if (filter.tanggalMulai || filter.tanggalSelesai) { %>
                      <a href="/riwayat" class="btn btn-secondary">Reset Filter</a>
                      <% } %>
                  </div>
                  <% } %>
        </div>
      </main>

      <footer class="footer">
        <div class="container">
          <p>&copy; 2026 Chatbot Administrasi Desa. All rights reserved.</p>
        </div>
      </footer>
</body>

</html>