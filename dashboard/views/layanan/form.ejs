<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= mode==='tambah' ? 'Tambah' : 'Edit' %> Layanan - Dashboard Chatbot Desa
  </title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <% if (admin.adminId) { %>
    <!-- Navbar -->
    <nav class="navbar">
      <div class="container">
        <div class="navbar-brand">
          <h1>🏛️ Dashboard Chatbot Desa</h1>
        </div>
        <ul class="navbar-menu">
          <li><a href="/">Dashboard</a></li>
          <li><a href="/layanan" class="active">Layanan</a></li>
          <li><a href="/kategori">Kategori</a></li>
          <li><a href="/riwayat">Riwayat Chat</a></li>
          <li><a href="/statistik">Statistik</a></li>
          <li><a href="/live-chat">Live Chat</a></li>
          <li><a href="/bot-status">Status Bot</a></li>
        </ul>
        <div class="navbar-user">
          <span>👤 <%= admin.adminNama || admin.adminUsername %></span>
          <a href="/logout" class="btn-logout">Logout</a>
        </div>
      </div>
    </nav>
    <% } %>

      <main class="main-content">
        <div class="container">
          <div class="page-header">
            <div>
              <h2>
                <%= mode==='tambah' ? 'Tambah' : 'Edit' %> Layanan
              </h2>
              <p class="subtitle">
                <a href="/layanan">← Kembali ke Daftar Layanan</a>
              </p>
            </div>
          </div>

          <div class="form-container">
            <form action="<%= mode === 'tambah' ? '/layanan/tambah' : '/layanan/edit/' + layanan.id %>" method="POST"
              id="formLayanan">
              <!-- Nama Layanan -->
              <div class="form-group">
                <label for="nama">Nama Layanan *</label>
                <input type="text" id="nama" name="nama" value="<%= layanan ? layanan.nama : '' %>" required
                  placeholder="Contoh: Akta Kelahiran">
              </div>

              <!-- Kategori -->
              <div class="form-group">
                <label for="kategoriId">Kategori</label>
                <select id="kategoriId" name="kategori_id">
                  <option value="">— Pilih Kategori (opsional) —</option>
                  <% kategoriList.forEach(kat=> { %>
                    <option value="<%= kat.id %>" <%=layanan && layanan.kategori_id==kat.id ? 'selected' : '' %>>
                      <%= kat.nama %>
                    </option>
                    <% }); %>
                </select>
                <p class="help-text">💡 Kelompokkan layanan ini ke dalam kategori (misal: KK, KTP, Akta).</p>
              </div>

              <!-- Syarat-syarat -->
              <div class="form-group">
                <label>Syarat-syarat yang Dibutuhkan</label>
                <p class="help-text">Tambahkan syarat satu per satu. Klik "Tambah Syarat" untuk menambah baris baru.</p>

                <div id="syaratContainer">
                  <% if (syaratList && syaratList.length> 0) { %>
                    <% syaratList.forEach((syarat, index)=> { %>
                      <div class="syarat-item">
                        <span class="syarat-number">
                          <%= index + 1 %>.
                        </span>
                        <input type="text" name="syarat[]" value="<%= syarat.deskripsi %>" placeholder="Masukkan syarat"
                          required>
                        <button type="button" class="btn btn-sm btn-danger" onclick="hapusSyarat(this)">×</button>
                      </div>
                      <% }); %>
                        <% } else { %>
                          <div class="syarat-item">
                            <span class="syarat-number">1.</span>
                            <input type="text" name="syarat[]" placeholder="Masukkan syarat" required>
                            <button type="button" class="btn btn-sm btn-danger" onclick="hapusSyarat(this)">×</button>
                          </div>
                          <% } %>
                </div>

                <button type="button" class="btn btn-secondary" onclick="tambahSyarat()">
                  + Tambah Syarat
                </button>
              </div>

              <!-- Sub-Opsi -->
              <div class="form-group">
                <label>Sub-Opsi / Jenis Layanan (opsional)</label>
                <p class="help-text">
                  Tambahkan sub-opsi bila layanan ini punya beberapa jenis (misal KTP: "Karena Hilang" dan
                  "Baru"). Setiap sub-opsi bisa punya syarat sendiri.
                </p>

                <div id="subOpsiContainer">
                  <% if (subOpsiList && subOpsiList.length> 0) { %>
                    <% subOpsiList.forEach((so, soIndex)=> { %>
                      <div class="sub-opsi-item" data-index="<%= soIndex %>">
                        <div class="sub-opsi-header">
                          <span class="sub-opsi-number">
                            <%= soIndex + 1 %>.
                          </span>
                          <input type="text" name="sub_opsi_nama[]" value="<%= so.nama %>"
                            placeholder="Nama sub-opsi (misal: Karena Hilang)">
                          <button type="button" class="btn btn-sm btn-danger" onclick="hapusSubOpsi(this)">×</button>
                        </div>
                        <div class="sub-opsi-syarat">
                          <% if (so.syaratList && so.syaratList.length> 0) { %>
                            <% so.syaratList.forEach((ss, ssIdx)=> { %>
                              <div class="syarat-item">
                                <span class="syarat-number">
                                  <%= ssIdx + 1 %>.
                                </span>
                                <input type="text" name="sub_opsi_syarat[<%= soIndex %>][]" value="<%= ss.deskripsi %>"
                                  placeholder="Syarat sub-opsi">
                                <button type="button" class="btn btn-sm btn-danger"
                                  onclick="hapusSyarat(this)">×</button>
                              </div>
                              <% }); %>
                                <% } else { %>
                                  <div class="syarat-item">
                                    <span class="syarat-number">1.</span>
                                    <input type="text" name="sub_opsi_syarat[<%= soIndex %>][]"
                                      placeholder="Syarat sub-opsi">
                                    <button type="button" class="btn btn-sm btn-danger"
                                      onclick="hapusSyarat(this)">×</button>
                                  </div>
                                  <% } %>
                        </div>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="tambahSyaratSub(this)">+
                          Syarat</button>
                      </div>
                      <% }); %>
                        <% } %>
                </div>

                <button type="button" class="btn btn-secondary" onclick="tambahSubOpsi()">+ Tambah Sub-Opsi</button>
              </div>

              <!-- Submit Buttons -->
              <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                  <%= mode==='tambah' ? '✅ Simpan Layanan' : '💾 Update Layanan' %>
                </button>
                <a href="/layanan" class="btn btn-secondary">Batal</a>
              </div>
            </form>
          </div>
        </div>
      </main>

      <footer class="footer">
        <div class="container">
          <p>&copy; 2026 Chatbot Administrasi Desa. All rights reserved.</p>
        </div>
      </footer>

      <script>
        let syaratCount = document.querySelectorAll('.syarat-item').length;

        function tambahSyarat() {
          syaratCount++;
          const container = document.getElementById('syaratContainer');
          const div = document.createElement('div');
          div.className = 'syarat-item';
          div.innerHTML = `
        <span class="syarat-number">${syaratCount}.</span>
        <input 
          type="text" 
          name="syarat[]" 
          placeholder="Masukkan syarat"
          required
        >
        <button type="button" class="btn btn-sm btn-danger" onclick="hapusSyarat(this)">×</button>
      `;
          container.appendChild(div);
          updateNomor();
        }

        function hapusSyarat(button) {
          const item = button.closest('.syarat-item');
          const container = item.parentElement;
          const items = container.querySelectorAll('.syarat-item');
          if (items.length > 1) {
            item.remove();
            updateNomor();
          } else {
            alert('Minimal harus ada 1 syarat!');
          }
        }

        function updateNomor() {
          const items = document.querySelectorAll('.syarat-item');
          items.forEach((item, index) => {
            item.querySelector('.syarat-number').textContent = (index + 1) + '.';
          });
          syaratCount = items.length;
        }

        // ── Sub-Opsi ──────────────────────────────────────────────
        let subOpsiCount = document.querySelectorAll('.sub-opsi-item').length;

        function tambahSubOpsi() {
          const container = document.getElementById('subOpsiContainer');
          const div = document.createElement('div');
          div.className = 'sub-opsi-item';
          div.innerHTML = `
            <div class="sub-opsi-header">
              <span class="sub-opsi-number">${subOpsiCount + 1}.</span>
              <input type="text" name="sub_opsi_nama[]" placeholder="Nama sub-opsi (misal: Karena Hilang)">
              <button type="button" class="btn btn-sm btn-danger" onclick="hapusSubOpsi(this)">×</button>
            </div>
            <div class="sub-opsi-syarat">
              <div class="syarat-item">
                <span class="syarat-number">1.</span>
                <input type="text" name="sub_opsi_syarat[${subOpsiCount}][]" placeholder="Syarat sub-opsi">
                <button type="button" class="btn btn-sm btn-danger" onclick="hapusSyarat(this)">×</button>
              </div>
            </div>
            <button type="button" class="btn btn-sm btn-secondary" onclick="tambahSyaratSub(this)">+ Syarat</button>
          `;
          container.appendChild(div);
          subOpsiCount++;
          updateSubOpsiNomor();
        }

        function hapusSubOpsi(button) {
          button.closest('.sub-opsi-item').remove();
          updateSubOpsiNomor();
        }

        function tambahSyaratSub(btn) {
          const subItem = btn.closest('.sub-opsi-item');
          const syaratBox = subItem.querySelector('.sub-opsi-syarat');
          const idx = subItem.querySelector('.sub-opsi-number').textContent.replace('.', '') - 1;
          const div = document.createElement('div');
          div.className = 'syarat-item';
          div.innerHTML = `
            <span class="syarat-number">${syaratBox.children.length + 1}.</span>
            <input type="text" name="sub_opsi_syarat[${idx}][]" placeholder="Syarat sub-opsi">
            <button type="button" class="btn btn-sm btn-danger" onclick="hapusSyarat(this)">×</button>
          `;
          syaratBox.appendChild(div);
          updateSubSyaratNomor(syaratBox);
        }

        function updateSubOpsiNomor() {
          const items = document.querySelectorAll('.sub-opsi-item');
          items.forEach((item, index) => {
            item.querySelector('.sub-opsi-number').textContent = (index + 1) + '.';
          });
          subOpsiCount = items.length;
        }

        function updateSubSyaratNomor(box) {
          const items = box.querySelectorAll('.syarat-item');
          items.forEach((item, index) => {
            item.querySelector('.syarat-number').textContent = (index + 1) + '.';
          });
        }

        // Validasi form sebelum submit
        document.getElementById('formLayanan').addEventListener('submit', function (e) {
          const inputs = document.querySelectorAll('input[name="syarat[]"]');
          let valid = true;

          inputs.forEach(input => {
            if (!input.value.trim()) {
              valid = false;
            }
          });

          if (!valid) {
            e.preventDefault();
            alert('Semua field syarat harus diisi atau dihapus!');
          }
        });
      </script>
</body>

</html>