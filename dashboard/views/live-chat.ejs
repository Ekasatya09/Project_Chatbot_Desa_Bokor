<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Chat - Dashboard Chatbot Desa</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* ===== LIVE CHAT PAGE STYLES ===== */
    .lc-grid {
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 1.5rem;
      height: calc(100vh - 200px);
      min-height: 500px;
    }

    /* Panel kiri: daftar sesi */
    .lc-sidebar {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .lc-sidebar-header {
      padding: 1rem 1.25rem;
      background: #1a56db;
      color: #fff;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .lc-sesi-list {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem;
    }
    .lc-sesi-item {
      padding: 0.85rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      border: 2px solid transparent;
      margin-bottom: 0.4rem;
      transition: all 0.15s;
      background: #f8fafc;
    }
    .lc-sesi-item:hover { background: #e8f0fe; border-color: #c7d7fd; }
    .lc-sesi-item.active { background: #ebf5ff; border-color: #1a56db; }
    .lc-sesi-item .nomor { font-weight: 600; font-size: 0.9rem; color: #1e293b; }
    .lc-sesi-item .meta { font-size: 0.75rem; color: #64748b; margin-top: 2px; }
    .badge-aktif  { background: #d1fae5; color: #065f46; padding: 2px 8px; border-radius: 99px; font-size: 0.7rem; font-weight: 600; }
    .badge-selesai { background: #f1f5f9; color: #64748b; padding: 2px 8px; border-radius: 99px; font-size: 0.7rem; font-weight: 600; }
    .badge-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px; }
    .badge-dot.aktif { background: #10b981; }
    .badge-dot.selesai { background: #94a3b8; }

    /* Panel kanan: chat + konfigurasi */
    .lc-main {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* Konfigurasi nomor admin */
    .lc-config-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .lc-config-card label { font-size: 0.875rem; font-weight: 600; color: #374151; white-space: nowrap; }
    .lc-config-card input {
      flex: 1;
      min-width: 200px;
      padding: 0.45rem 0.75rem;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 0.875rem;
    }
    .lc-config-card .hint { font-size: 0.75rem; color: #6b7280; width: 100%; }

    /* Kotak detail chat */
    .lc-chat-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .lc-chat-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .lc-chat-header .title { font-weight: 600; color: #1e293b; }
    .lc-chat-body {
      flex: 1;
      overflow-y: auto;
      padding: 1rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      background: #f8fafc;
    }
    .lc-chat-empty {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94a3b8;
      font-size: 0.95rem;
      flex-direction: column;
      gap: 0.5rem;
      padding: 2rem;
    }
    .lc-bubble {
      max-width: 75%;
      padding: 0.6rem 0.9rem;
      border-radius: 12px;
      font-size: 0.875rem;
      line-height: 1.5;
      word-break: break-word;
    }
    .lc-bubble.masuk  {
      background: #fff;
      border: 1px solid #e2e8f0;
      align-self: flex-start;
      border-bottom-left-radius: 4px;
    }
    .lc-bubble.keluar {
      background: #1a56db;
      color: #fff;
      align-self: flex-end;
      border-bottom-right-radius: 4px;
    }
    .lc-bubble .bubble-meta { font-size: 0.7rem; opacity: 0.65; margin-top: 4px; }
    .lc-bubble.masuk .bubble-meta { text-align: left; }
    .lc-bubble.keluar .bubble-meta { text-align: right; }

    /* Btn akhiri sesi */
    .btn-danger { background: #ef4444; color: #fff; border: none; padding: 0.4rem 0.9rem; border-radius: 8px; cursor: pointer; font-size: 0.8rem; font-weight: 600; transition: background 0.2s; }
    .btn-danger:hover { background: #dc2626; }
    .btn-save { background: #1a56db; color: #fff; border: none; padding: 0.45rem 1rem; border-radius: 8px; cursor: pointer; font-size: 0.875rem; font-weight: 600; transition: background 0.2s; }
    .btn-save:hover { background: #1e40af; }
    .btn-save:disabled { background: #93c5fd; cursor: not-allowed; }

    #toastNotif {
      position: fixed; bottom: 1.5rem; right: 1.5rem;
      background: #1e293b; color: #fff;
      padding: 0.75rem 1.25rem; border-radius: 10px;
      font-size: 0.875rem; z-index: 9999;
      opacity: 0; transition: opacity 0.3s;
      pointer-events: none;
    }
    #toastNotif.show { opacity: 1; }

    .refresh-hint { font-size: 0.7rem; color: #94a3b8; }
  </style>
</head>
<body>
  <!-- Notifikasi live chat (banner tengah-atas) -->
  <div id="livechatNotifContainer"></div>

<% if (admin.adminId) { %>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="container">
      <div class="navbar-brand"><h1>🏛️ Dashboard Chatbot Desa</h1></div>
      <ul class="navbar-menu">
        <li><a href="/">Dashboard</a></li>
        <li><a href="/layanan">Layanan</a></li>
        <li><a href="/riwayat">Riwayat Chat</a></li>
        <li><a href="/statistik">Statistik</a></li>
        <li><a href="/live-chat" class="active">Live Chat</a></li>
      </ul>
      <div class="navbar-user">
        <span>👤 <%= admin.adminNama || admin.adminUsername %></span>
        <a href="/logout" class="btn-logout">Logout</a>
      </div>
    </div>
  </nav>
<% } %>

<main class="main-content">
  <div class="container">
    <h2>💬 Live Chat Admin</h2>
    <p class="subtitle">Monitor sesi percakapan langsung antara pengguna dan admin</p>

    <!-- Konfigurasi Nomor WA Admin -->
    <div class="lc-config-card" style="margin-bottom:1rem;">
      <label>📱 Nomor WA Admin (penerima pesan):</label>
      <input type="text" id="inputNomorAdmin" placeholder="Contoh: 08123456789 atau 628123456789"
        value="<%= adminWa || '' %>">
      <button class="btn-save" id="btnSimpanNomor" onclick="simpanNomorAdmin()">Simpan</button>
      <span class="hint">
        💡 Nomor ini akan menerima notifikasi & pesan dari pengguna yang meminta live chat (pilihan 98).
        Admin membalas langsung dari WhatsApp ke nomor bot.
        Ketik <strong>!selesai</strong> dari WA admin untuk mengakhiri sesi.
      </span>
    </div>

    <div class="lc-grid">
      <!-- Panel Kiri: Daftar Sesi -->
      <div class="lc-sidebar">
        <div class="lc-sidebar-header">
          💬 Sesi Live Chat
          <span class="refresh-hint" style="margin-left:auto;color:rgba(255,255,255,0.7);" id="refreshHint">auto-refresh 10s</span>
        </div>
        <div class="lc-sesi-list" id="sesiList">
          <% if (sesiList.length === 0) { %>
            <div style="text-align:center;color:#94a3b8;padding:2rem;font-size:0.875rem;">
              Belum ada sesi live chat
            </div>
          <% } else { %>
            <% sesiList.forEach(s => { %>
              <div class="lc-sesi-item" onclick="pilihSesi(<%= s.id %>, '<%= s.nomor_wa_bersih %>')" data-id="<%= s.id %>">
                <div class="nomor">
                  <span class="badge-dot <%= s.status %>"></span>
                  +<%= s.nomor_wa_bersih %>
                </div>
                <div class="meta">
                  <span class="badge-<%= s.status %>"><%= s.status === 'aktif' ? '🟢 Aktif' : '⚫ Selesai' %></span>
                  &nbsp;
                  <%= new Date(s.mulai_at).toLocaleString('id-ID', {dateStyle:'short', timeStyle:'short'}) %>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Panel Kanan: Detail Chat -->
      <div class="lc-main">
        <div class="lc-chat-card" id="chatCard">
          <div class="lc-chat-header">
            <span class="title" id="chatTitle">Pilih sesi untuk melihat percakapan</span>
            <div style="display:flex;align-items:center;gap:0.5rem;">
              <span id="chatStatus"></span>
              <button class="btn-danger" id="btnAkhiri" style="display:none;" onclick="akhiriSesi()">⛔ Akhiri Sesi</button>
            </div>
          </div>
          <div class="lc-chat-body" id="chatBody">
            <div class="lc-chat-empty">
              <div style="font-size:2.5rem;">💬</div>
              <div>Pilih sesi dari daftar kiri untuk melihat percakapan</div>
              <div style="font-size:0.8rem;">Halaman ini auto-refresh setiap 10 detik</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<div id="toastNotif"></div>

<script>
  let sesiAktifId = null;
  let sesiAktifNomor = null;
  let autoRefreshInterval = null;

  function toast(msg, duration = 2500) {
    const el = document.getElementById('toastNotif');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), duration);
  }

  // ── Simpan nomor admin ─────────────────────────────────────────
  async function simpanNomorAdmin() {
    const nomor = document.getElementById('inputNomorAdmin').value.trim();
    const btn = document.getElementById('btnSimpanNomor');
    btn.disabled = true;
    btn.textContent = 'Menyimpan...';

    try {
      const res = await fetch('/api/admin/nomor-wa', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nomor_wa: nomor }),
        credentials: 'include'
      });
      const data = await res.json();
      if (data.ok) {
        toast('✅ Nomor WA admin berhasil disimpan!');
      } else {
        toast('❌ Gagal menyimpan: ' + (data.error || 'Error tidak diketahui'));
      }
    } catch (e) {
      toast('❌ Gagal terhubung ke server');
    }
    btn.disabled = false;
    btn.textContent = 'Simpan';
  }

  // ── Pilih sesi ─────────────────────────────────────────────────
  function pilihSesi(id, nomor) {
    sesiAktifId = id;
    sesiAktifNomor = nomor;
    document.querySelectorAll('.lc-sesi-item').forEach(el => el.classList.remove('active'));
    const el = document.querySelector(`.lc-sesi-item[data-id="${id}"]`);
    if (el) el.classList.add('active');
    muatPesan();
  }

  // ── Muat pesan sesi ────────────────────────────────────────────
  async function muatPesan() {
    if (!sesiAktifId) return;
    try {
      const res = await fetch(`/api/live-chat/${sesiAktifId}/pesan`, { credentials: 'include' });
      const data = await res.json();
      if (!data.sesi) return;

      const sesi = data.sesi;
      const pesanList = data.pesanList || [];

      document.getElementById('chatTitle').textContent =
        `💬 Sesi dengan +${sesi.nomor_wa_bersih}`;

      const statusEl = document.getElementById('chatStatus');
      const btnAkhiri = document.getElementById('btnAkhiri');

      if (sesi.status === 'aktif') {
        const expiredAt = new Date(sesi.expired_at);
        statusEl.innerHTML = `<span class="badge-aktif">🟢 Aktif — habis ${expiredAt.toLocaleString('id-ID', {dateStyle:'short', timeStyle:'short'})}</span>`;
        btnAkhiri.style.display = 'inline-block';
      } else {
        const selesaiAt = sesi.selesai_at ? new Date(sesi.selesai_at).toLocaleString('id-ID', {dateStyle:'short', timeStyle:'short'}) : '-';
        statusEl.innerHTML = `<span class="badge-selesai">⚫ Selesai — ${selesaiAt}</span>`;
        btnAkhiri.style.display = 'none';
      }

      const body = document.getElementById('chatBody');
      if (pesanList.length === 0) {
        body.innerHTML = '<div class="lc-chat-empty"><div>Belum ada pesan dalam sesi ini</div></div>';
        return;
      }

      body.innerHTML = pesanList.map(p => {
        const waktu = new Date(p.waktu).toLocaleString('id-ID', { timeStyle: 'short' });
        const label = p.arah === 'masuk' ? `👤 User` : `🔑 Admin`;
        return `
          <div class="lc-bubble ${p.arah}">
            <div>${escapeHtml(p.isi)}</div>
            <div class="bubble-meta">${label} · ${waktu}</div>
          </div>
        `;
      }).join('');

      // Scroll ke bawah
      body.scrollTop = body.scrollHeight;
    } catch (e) {
      console.error('Gagal muat pesan:', e);
    }
  }

  // ── Akhiri sesi ────────────────────────────────────────────────
  async function akhiriSesi() {
    if (!sesiAktifId) return;
    if (!confirm(`Yakin ingin mengakhiri sesi dengan +${sesiAktifNomor}?\n\nPengguna akan mendapat notifikasi bahwa sesi telah berakhir.`)) return;

    try {
      const res = await fetch(`/api/live-chat/${sesiAktifId}/akhiri`, {
        method: 'POST',
        credentials: 'include'
      });
      const data = await res.json();
      if (data.ok) {
        toast('✅ Sesi berhasil diakhiri. Bot akan mengirim notifikasi ke pengguna dalam 1 menit.');
        await refreshSesiList();
        await muatPesan();
      } else {
        toast('❌ ' + (data.error || 'Gagal mengakhiri sesi'));
      }
    } catch (e) {
      toast('❌ Gagal terhubung ke server');
    }
  }

  // ── Refresh daftar sesi ────────────────────────────────────────
  async function refreshSesiList() {
    try {
      const res = await fetch('/api/live-chat', { credentials: 'include' });
      const data = await res.json();
      const sesiList = data.sesiList || [];

      const listEl = document.getElementById('sesiList');
      if (sesiList.length === 0) {
        listEl.innerHTML = '<div style="text-align:center;color:#94a3b8;padding:2rem;font-size:0.875rem;">Belum ada sesi live chat</div>';
        return;
      }

      listEl.innerHTML = sesiList.map(s => `
        <div class="lc-sesi-item ${s.id === sesiAktifId ? 'active' : ''}"
          onclick="pilihSesi(${s.id}, '${s.nomor_wa_bersih}')"
          data-id="${s.id}">
          <div class="nomor">
            <span class="badge-dot ${s.status}"></span>
            +${s.nomor_wa_bersih}
          </div>
          <div class="meta">
            <span class="badge-${s.status}">${s.status === 'aktif' ? '🟢 Aktif' : '⚫ Selesai'}</span>
            &nbsp;
            ${new Date(s.mulai_at).toLocaleString('id-ID', {dateStyle:'short', timeStyle:'short'})}
          </div>
        </div>
      `).join('');
    } catch (e) {
      console.error('Gagal refresh sesi list:', e);
    }
  }

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/\n/g, '<br>');
  }

  // ── Auto-refresh setiap 10 detik ──────────────────────────────
  setInterval(async () => {
    await refreshSesiList();
    if (sesiAktifId) await muatPesan();
  }, 10000);
</script>

<!-- Notifikasi live chat: muncul saat ada sesi baru (fitur 98) -->
<script>
  (function () {
    const KEY = 'livechatDismissedIds';
    let dismissed = new Set();
    try {
      dismissed = new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));
    } catch (e) { dismissed = new Set(); }
    let shownBannerId = null;

    const container = document.getElementById('livechatNotifContainer');
    if (!container) return;

    function simpanDismissed() {
      try {
        localStorage.setItem(KEY, JSON.stringify([...dismissed]));
      } catch (e) { /* abaikan */ }
    }

    async function cekSesiBaru() {
      try {
        const res = await fetch('/api/live-chat', { credentials: 'include' });
        if (res.status === 401) return;
        const data = await res.json();
        const aktif = (data.sesiList || []).filter(s => s.status === 'aktif');

        const baru = aktif.find(s => !dismissed.has(String(s.id)));

        if (baru && shownBannerId !== baru.id) {
          shownBannerId = baru.id;
          container.innerHTML = `
            <div class="livechat-notif">
              <div class="lc-notif-icon">🔔</div>
              <div class="lc-notif-body">
                <div class="lc-notif-title">Permintaan Live Chat Masuk!</div>
                <div class="lc-notif-text">Pengguna +${baru.nomor_wa_bersih} meminta chat langsung dengan admin (fitur 98).</div>
              </div>
              <div class="lc-notif-actions">
                <a class="btn-notif-buka" href="/live-chat">Buka</a>
                <button class="btn-notif-tutup" title="Tutup" onclick="this.closest('.livechat-notif').remove(); dismissedAdd(${baru.id});">✕</button>
              </div>
            </div>
          `;
        }

        if (aktif.length === 0 && shownBannerId !== null) {
          shownBannerId = null;
          container.innerHTML = '';
        }
      } catch (e) {
        // abaikan
      }
    }

    window.dismissedAdd = function (id) {
      dismissed.add(String(id));
      simpanDismissed();
    };

    cekSesiBaru();
    setInterval(cekSesiBaru, 5000);
  })();
</script>

<footer class="footer">
  <div class="container">
    <p>&copy; 2026 Chatbot Administrasi Desa. All rights reserved.</p>
  </div>
</footer>
</body>
</html>
