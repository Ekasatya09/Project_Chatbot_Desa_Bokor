<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Status Bot - Dashboard Chatbot Desa</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .bot-card {
      background: #fff;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      padding: 2.5rem;
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    }
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.25rem;
      border-radius: 99px;
      font-weight: 700;
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
    .status-badge.connected    { background: #d1fae5; color: #065f46; }
    .status-badge.connecting   { background: #fef3c7; color: #92400e; }
    .status-badge.disconnected { background: #fee2e2; color: #991b1b; }

    .status-dot {
      width: 12px; height: 12px; border-radius: 50%; display: inline-block;
    }
    .status-dot.connected    { background: #10b981; animation: pulse-green 1.5s infinite; }
    .status-dot.connecting   { background: #f59e0b; animation: pulse-yellow 1s infinite; }
    .status-dot.disconnected { background: #ef4444; }

    @keyframes pulse-green  { 0%,100%{box-shadow:0 0 0 0 rgba(16,185,129,0.4)} 50%{box-shadow:0 0 0 8px rgba(16,185,129,0)} }
    @keyframes pulse-yellow { 0%,100%{box-shadow:0 0 0 0 rgba(245,158,11,0.4)} 50%{box-shadow:0 0 0 8px rgba(245,158,11,0)} }

    .qr-wrapper {
      background: #f8fafc;
      border: 2px dashed #cbd5e1;
      border-radius: 12px;
      padding: 1.5rem;
      margin: 1.5rem 0;
      min-height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 0.75rem;
    }
    .qr-wrapper img { border-radius: 8px; max-width: 260px; }

    .wa-nomor-box {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 10px;
      padding: 1rem 1.5rem;
      margin: 1rem 0;
      font-size: 1.1rem;
      font-weight: 600;
      color: #166534;
    }

    /* Tombol-tombol */
    .btn-group {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .btn-connect {
      background: #16a34a;
      color: #fff;
      border: none;
      padding: 0.875rem 2rem;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    .btn-connect:hover { background: #15803d; transform: translateY(-1px); }
    .btn-connect:disabled { background: #86efac; cursor: not-allowed; transform: none; }

    .btn-reset {
      background: #f59e0b;
      color: #fff;
      border: none;
      padding: 0.75rem 2rem;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }
    .btn-reset:hover { background: #d97706; transform: translateY(-1px); }
    .btn-reset:disabled { background: #fcd34d; cursor: not-allowed; transform: none; }

    .btn-hapus-wa {
      background: #ef4444;
      color: #fff;
      border: none;
      padding: 0.75rem 2rem;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }
    .btn-hapus-wa:hover { background: #dc2626; transform: translateY(-1px); }
    .btn-hapus-wa:disabled { background: #fca5a5; cursor: not-allowed; transform: none; }

    .info-text { font-size: 0.85rem; color: #64748b; margin-top: 0.5rem; }
    .refresh-info { font-size: 0.75rem; color: #94a3b8; margin-top: 1rem; }

    .steps-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 1rem 1.25rem;
      text-align: left;
      margin: 1rem 0;
      font-size: 0.875rem;
      color: #374151;
    }
    .steps-box ol { margin: 0.5rem 0 0 1.25rem; padding: 0; }
    .steps-box li { margin-bottom: 0.3rem; }

    #toastNotif {
      position: fixed; bottom: 1.5rem; right: 1.5rem;
      background: #1e293b; color: #fff;
      padding: 0.75rem 1.25rem; border-radius: 10px;
      font-size: 0.875rem; z-index: 9999;
      opacity: 0; transition: opacity 0.3s;
      pointer-events: none;
    }
    #toastNotif.show { opacity: 1; }

    /* QR loading spinner */
    .qr-spinner {
      width: 48px; height: 48px;
      border: 4px solid #e2e8f0;
      border-top-color: #0ea5e9;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 0.5rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
<% if (admin.adminId) { %>
<nav class="navbar">
  <div class="container">
    <div class="navbar-brand"><h1>🏛️ Dashboard Chatbot Desa</h1></div>
    <ul class="navbar-menu">
      <li><a href="/">Dashboard</a></li>
      <li><a href="/layanan">Layanan</a></li>
      <li><a href="/riwayat">Riwayat Chat</a></li>
      <li><a href="/statistik">Statistik</a></li>
      <li><a href="/live-chat">Live Chat</a></li>
      <li><a href="/bot-status" class="active">Status Bot</a></li>
    </ul>
    <div class="navbar-user">
      <span>👤 <%= admin.adminNama || admin.adminUsername %></span>
      <a href="/logout" class="btn-logout">Logout</a>
    </div>
  </div>
</nav>
<% } %>

<main class="main-content">
  <div class="container">
    <h2>📱 Status Bot WhatsApp</h2>
    <p class="subtitle">Monitor koneksi dan kelola bot dari sini</p>

    <% if (autoconnect && botStatus !== 'connected') { %>
    <div style="background:#fef3c7;border:1px solid #fde68a;border-radius:10px;padding:0.875rem 1.25rem;margin-bottom:1.5rem;font-size:0.9rem;color:#92400e;text-align:center;">
      📲 <strong>Selamat datang!</strong> WhatsApp belum terhubung. Scan QR di bawah untuk mulai menggunakan chatbot.
    </div>
    <% } %>

    <div class="bot-card">
      <!-- Status Badge -->
      <div>
        <span class="status-badge <%= botStatus === 'connected' ? 'connected' : botStatus === 'connecting' ? 'connecting' : 'disconnected' %>"
              id="statusBadge">
          <span class="status-dot <%= botStatus === 'connected' ? 'connected' : botStatus === 'connecting' ? 'connecting' : 'disconnected' %>"
                id="statusDot"></span>
          <span id="statusText">
            <% if (botStatus === 'connected') { %>🟢 Terhubung<% } else if (botStatus === 'connecting') { %>🟡 Menghubungkan...<% } else { %>🔴 Terputus<% } %>
          </span>
        </span>
      </div>

      <!-- Nomor WA terhubung -->
      <% if (botStatus === 'connected' && waNomor) { %>
      <div class="wa-nomor-box" id="waNomorBox">
        📞 Terhubung sebagai: <strong>+<%= waNomor %></strong>
      </div>
      <% } else { %>
      <div id="waNomorBox" style="display:none" class="wa-nomor-box"></div>
      <% } %>

      <!-- QR Code area -->
      <div class="qr-wrapper" id="qrWrapper">
        <% if (botStatus === 'connecting') { %>
          <div class="qr-spinner" id="qrSpinner"></div>
          <div id="qrLoading" style="color:#64748b;font-size:0.9rem;">⏳ Memuat QR Code...</div>
          <img id="qrImage" src="" alt="QR Code" style="display:none;">
          <div id="qrHint" style="font-size:0.8rem;color:#64748b;display:none;">
            Scan dengan WhatsApp → Perangkat Tertaut → Tautkan Perangkat
          </div>
        <% } else if (botStatus === 'connected') { %>
          <div style="font-size:3rem;">✅</div>
          <div style="font-weight:600;color:#065f46;">Bot aktif dan siap menerima pesan!</div>
        <% } else { %>
          <div class="qr-spinner"></div>
          <div style="color:#64748b;font-size:0.9rem;">⏳ Memulai koneksi WhatsApp...</div>
        <% } %>
      </div>

      <!-- Panduan scan (muncul saat connecting) -->
      <div class="steps-box" id="scanSteps" style="display:<%= botStatus === 'connecting' ? 'block' : 'none' %>">
        <strong>📋 Cara scan QR:</strong>
        <ol>
          <li>Buka WhatsApp di HP</li>
          <li>Ketuk ⋮ (titik tiga) → <em>Perangkat Tertaut</em></li>
          <li>Ketuk <em>Tautkan Perangkat</em></li>
          <li>Arahkan kamera ke QR di atas</li>
        </ol>
      </div>

      <!-- Info -->
      <p class="info-text" id="infoText">
        <% if (botStatus === 'connected') { %>
          Bot berjalan normal. Gunakan tombol di bawah untuk mengelola koneksi.
        <% } else if (botStatus === 'connecting') { %>
          Menunggu scan QR. QR auto-refresh setiap beberapa detik.
        <% } else { %>
          Klik <strong>Hubungkan WhatsApp</strong> untuk memulai koneksi dan menampilkan QR.
        <% } %>
      </p>

      <!-- Tombol-tombol -->
      <div class="btn-group" id="btnGroup">
        <!-- Tombol Hubungkan (muncul saat disconnected) -->
        <button class="btn-connect" id="btnConnect"
                style="display:<%= botStatus === 'disconnected' ? 'flex' : 'none' %>"
                onclick="hubungkanWhatsApp()">
          📲 Hubungkan WhatsApp
        </button>

        <!-- Tombol Reset (muncul saat connecting atau connected) -->
        <button class="btn-reset" id="btnReset"
                style="display:<%= botStatus !== 'disconnected' ? 'inline-block' : 'none' %>"
                onclick="resetWhatsApp()">
          🔄 Ganti / Reset Koneksi
        </button>

        <!-- Tombol Hapus WA (muncul hanya saat connected) -->
        <button class="btn-hapus-wa" id="btnHapusWA"
                style="display:<%= botStatus === 'connected' ? 'inline-block' : 'none' %>"
                onclick="hapusWhatsApp()">
          🗑️ Hapus / Putuskan WhatsApp
        </button>
      </div>

      <p class="info-text" id="infoBtn" style="font-size:0.8rem;color:#94a3b8;margin-top:0.5rem;">
        <% if (botStatus === 'connected') { %>
          Reset: ganti akun WA &nbsp;|&nbsp; Hapus: putuskan koneksi tanpa scan ulang
        <% } else if (botStatus === 'connecting') { %>
          Reset akan memulai ulang proses koneksi WhatsApp
        <% } %>
      </p>

      <p class="refresh-info" id="refreshInfo">Auto-refresh status setiap 3 detik</p>
    </div>
  </div>
</main>

<div id="toastNotif"></div>

<script>
  let pollInterval = null;

  function toast(msg, duration = 3500) {
    const el = document.getElementById('toastNotif');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), duration);
  }

  async function fetchBotStatus() {
    try {
      const res = await fetch('/api/bot/status', { credentials: 'include' });
      return await res.json();
    } catch { return null; }
  }

  async function fetchQR() {
    try {
      const res = await fetch('/api/bot/qr', { credentials: 'include' });
      return await res.json();
    } catch { return null; }
  }

  function setStatusUI(status, waNomor) {
    const badge   = document.getElementById('statusBadge');
    const dot     = document.getElementById('statusDot');
    const text    = document.getElementById('statusText');
    const qrWrapper  = document.getElementById('qrWrapper');
    const waNomorBox = document.getElementById('waNomorBox');
    const infoText   = document.getElementById('infoText');
    const infoBtn    = document.getElementById('infoBtn');
    const scanSteps  = document.getElementById('scanSteps');
    const btnConnect = document.getElementById('btnConnect');
    const btnReset   = document.getElementById('btnReset');
    const btnHapus   = document.getElementById('btnHapusWA');

    // Reset kelas badge/dot
    badge.className = 'status-badge ' + status;
    dot.className   = 'status-dot ' + status;

    if (status === 'connected') {
      text.textContent = '🟢 Terhubung';
      qrWrapper.innerHTML = '<div style="font-size:3rem;">✅</div><div style="font-weight:600;color:#065f46;">Bot aktif dan siap menerima pesan!</div>';
      if (waNomor) {
        waNomorBox.style.display = 'block';
        waNomorBox.innerHTML = `📞 Terhubung sebagai: <strong>+${waNomor}</strong>`;
      }
      infoText.textContent = 'Bot berjalan normal. Gunakan tombol di bawah untuk mengelola koneksi.';
      infoBtn.textContent  = 'Reset: ganti akun WA | Hapus: putuskan koneksi tanpa scan ulang';
      scanSteps.style.display  = 'none';
      btnConnect.style.display = 'none';
      btnReset.style.display   = 'inline-block';
      btnHapus.style.display   = 'inline-block';

    } else if (status === 'connecting') {
      text.textContent = '🟡 Menghubungkan...';
      waNomorBox.style.display = 'none';
      infoText.textContent = 'Menunggu scan QR. QR auto-refresh setiap beberapa detik.';
      infoBtn.textContent  = 'Reset akan memulai ulang proses koneksi WhatsApp';
      scanSteps.style.display  = 'block';
      btnConnect.style.display = 'none';
      btnReset.style.display   = 'inline-block';
      btnHapus.style.display   = 'none';
      // Load QR
      loadQR();

    } else {
      text.textContent = '🔴 Terputus';
      waNomorBox.style.display = 'none';
      qrWrapper.innerHTML = '<div style="font-size:3rem;">📵</div><div style="color:#64748b;">WhatsApp belum terhubung.<br>Klik <strong>Hubungkan WhatsApp</strong> untuk mulai.</div>';
      infoText.innerHTML  = 'Klik <strong>Hubungkan WhatsApp</strong> untuk memulai koneksi dan menampilkan QR.';
      infoBtn.textContent = '';
      scanSteps.style.display  = 'none';
      btnConnect.style.display = 'flex';
      btnReset.style.display   = 'none';
      btnHapus.style.display   = 'none';
    }
  }

  async function loadQR() {
    const qrWrapper = document.getElementById('qrWrapper');
    const data = await fetchQR();
    if (!data) return;

    if (data.qr && data.status === 'connecting') {
      qrWrapper.innerHTML = `
        <img src="${data.qr}" alt="QR Code WhatsApp" style="border-radius:8px;max-width:260px;">
        <div style="font-size:0.8rem;color:#64748b;margin-top:0.5rem;">
          Scan dengan WhatsApp → Perangkat Tertaut → Tautkan Perangkat
        </div>
      `;
    } else if (data.status === 'connecting') {
      qrWrapper.innerHTML = `
        <div class="qr-spinner"></div>
        <div style="color:#64748b;padding:0.5rem;font-size:0.9rem;">⏳ Menunggu QR dari server...</div>
      `;
    }
  }

  // ── Polling status setiap 3 detik ─────────────────────────────
  let lastStatus = '<%= botStatus %>';
  let qrRefreshCount = 0;

  async function pollStatus() {
    const data = await fetchBotStatus();
    if (!data) return;

    if (data.status !== lastStatus) {
      lastStatus = data.status;
      setStatusUI(data.status, data.wa_nomor);
      if (data.status === 'connected') {
        toast('✅ Bot berhasil terhubung ke WhatsApp!');
      } else if (data.status === 'disconnected') {
        toast('⚠️ Bot terputus dari WhatsApp.');
      }
    }

    // Refresh QR setiap 6 detik saat connecting
    if (data.status === 'connecting') {
      qrRefreshCount++;
      if (qrRefreshCount % 2 === 0) loadQR();
    } else {
      qrRefreshCount = 0;
    }
  }

  // Mulai polling
  if ('<%= botStatus %>' === 'connecting') {
    setTimeout(loadQR, 800);
  }
  setInterval(pollStatus, 3000);

  // ── Auto-connect saat halaman dibuka pertama kali ───────────────
  // Jika status disconnected (termasuk redirect dari login), langsung mulai koneksi
  const _autoconnect = <%- JSON.stringify(autoconnect) %>;
  if ('<%= botStatus %>' === 'disconnected') {
    // Tampilkan spinner dulu
    setStatusUI('connecting', null);
    // Langsung hubungkan tanpa klik tombol
    setTimeout(async () => {
      try {
        const res = await fetch('/api/bot/connect', { method: 'POST', credentials: 'include' });
        const data = await res.json();
        if (data.ok) {
          if (_autoconnect) toast('📲 WhatsApp belum terhubung. Scan QR untuk melanjutkan...');
          setTimeout(loadQR, 2000);
        } else {
          // Jika gagal (misal sudah connecting), coba load QR saja
          setTimeout(loadQR, 1000);
        }
      } catch (e) {
        console.warn('Auto-connect gagal:', e);
      }
    }, 500);
  }

  // ── Hubungkan WhatsApp (dari disconnected) ──────────────────────
  async function hubungkanWhatsApp() {
    const btn = document.getElementById('btnConnect');
    btn.disabled = true;
    btn.innerHTML = '⏳ Menghubungkan...';

    try {
      const res = await fetch('/api/bot/connect', {
        method: 'POST',
        credentials: 'include'
      });
      const data = await res.json();
      if (data.ok) {
        toast('📲 Memulai koneksi WhatsApp... Menunggu QR code...');
        setStatusUI('connecting', null);
        setTimeout(loadQR, 2000);
      } else {
        toast('❌ Gagal memulai koneksi: ' + (data.error || 'Error tidak diketahui'));
        btn.disabled = false;
        btn.innerHTML = '📲 Hubungkan WhatsApp';
      }
    } catch (e) {
      toast('❌ Gagal terhubung ke server');
      btn.disabled = false;
      btn.innerHTML = '📲 Hubungkan WhatsApp';
    }
  }

  // ── Reset WhatsApp ─────────────────────────────────────────────
  async function resetWhatsApp() {
    if (!confirm('Ganti / Reset koneksi WhatsApp?\n\nIni akan:\n• Menghapus sesi login lama\n• Memerlukan scan QR baru\n• Bot akan offline sementara (~5 detik)')) return;

    const btn = document.getElementById('btnReset');
    btn.disabled = true;
    btn.textContent = '⏳ Mereset...';

    try {
      const res = await fetch('/api/bot/reset', {
        method: 'POST',
        credentials: 'include'
      });
      const data = await res.json();
      if (data.ok) {
        toast('🔄 Reset berhasil! Menunggu QR code baru...');
        setStatusUI('connecting', null);
        setTimeout(loadQR, 2000);
      } else {
        toast('❌ Reset gagal: ' + (data.error || 'Error tidak diketahui'));
      }
    } catch (e) {
      toast('❌ Gagal terhubung ke server');
    }

    btn.disabled = false;
    btn.textContent = '🔄 Ganti / Reset Koneksi';
  }

  // ── Hapus / Putuskan WhatsApp ───────────────────────────────────
  async function hapusWhatsApp() {
    if (!confirm('Hapus / Putuskan WhatsApp?\n\nIni akan:\n• Logout dari WhatsApp\n• Menghapus sesi login\n• Bot tidak aktif sampai dihubungkan lagi')) return;

    const btn = document.getElementById('btnHapusWA');
    btn.disabled = true;
    btn.textContent = '⏳ Memutuskan...';

    try {
      const res = await fetch('/api/bot/disconnect', {
        method: 'POST',
        credentials: 'include'
      });
      const data = await res.json();
      if (data.ok) {
        toast('🗑️ WhatsApp berhasil diputuskan. Bot tidak aktif.');
        setStatusUI('disconnected', null);
      } else {
        toast('❌ Gagal memutuskan: ' + (data.error || 'Error tidak diketahui'));
      }
    } catch (e) {
      toast('❌ Gagal terhubung ke server');
    }

    btn.disabled = false;
    btn.textContent = '🗑️ Hapus / Putuskan WhatsApp';
  }
</script>

<footer class="footer">
  <div class="container">
    <p>&copy; 2026 Chatbot Administrasi Desa. All rights reserved.</p>
  </div>
</footer>
</body>
</html>
