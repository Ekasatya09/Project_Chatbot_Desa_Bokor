<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Chatbot Desa</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <!-- Notifikasi live chat (banner tengah-atas) -->
  <div id="livechatNotifContainer"></div>

  <% if (admin.adminId) { %>
    <!-- Navbar -->
    <nav class="navbar">
      <div class="container">
        <div class="navbar-brand">
          <h1>🏛️ Dashboard Chatbot Desa</h1>
        </div>
        <ul class="navbar-menu">
          <li><a href="/" class="active">Dashboard</a></li>
          <li><a href="/layanan">Layanan</a></li>
          <li><a href="/riwayat">Riwayat Chat</a></li>
          <li><a href="/statistik">Statistik</a></li>
          <li><a href="/live-chat">Live Chat</a></li>
          <li><a href="/bot-status">Status Bot</a></li>
        </ul>
        <div class="navbar-user">
          <span>👤 <%= admin.adminNama || admin.adminUsername %></span>
          <a href="/logout" class="btn-logout">Logout</a>
        </div>
      </div>
    </nav>
    <% } %>

      <main class="main-content">
        <div class="container">
          <h2>Dashboard Utama</h2>
          <p class="subtitle">Selamat datang di dashboard admin chatbot administrasi desa</p>

          <!-- Stats Cards -->
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-icon">📋</div>
              <div class="stat-info">
                <h3>
                  <%= stats.totalLayanan %>
                </h3>
                <p>Total Layanan</p>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-icon">💬</div>
              <div class="stat-info">
                <h3>
                  <%= stats.totalChat %>
                </h3>
                <p>Total Percakapan</p>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-icon">📅</div>
              <div class="stat-info">
                <h3>
                  <%= stats.totalChatHariIni %>
                </h3>
                <p>Chat Hari Ini</p>
              </div>
            </div>
          </div>

          <!-- Top Layanan -->
          <div class="section">
            <h3>📊 Top 5 Layanan Paling Banyak Ditanya</h3>
            <% if (stats.topLayanan.length> 0) { %>
              <table class="table">
                <thead>
                  <tr>
                    <th>No</th>
                    <th>Nama Layanan</th>
                    <th>Jumlah Pertanyaan</th>
                  </tr>
                </thead>
                <tbody>
                  <% stats.topLayanan.forEach((item, index)=> { %>
                    <tr>
                      <td>
                        <%= index + 1 %>
                      </td>
                      <td>
                        <%= item.nama %>
                      </td>
                      <td><strong>
                          <%= item.jumlah %>
                        </strong></td>
                    </tr>
                    <% }); %>
                </tbody>
              </table>
              <% } else { %>
                <p class="text-muted">Belum ada data pertanyaan.</p>
                <% } %>
          </div>

          <!-- Chat Terbaru -->
          <div class="section">
            <h3>💬 Percakapan Terbaru</h3>
            <% if (stats.chatTerbaru.length> 0) { %>
              <table class="table">
                <thead>
                  <tr>
                    <th>Waktu</th>
                    <th>Nomor WA</th>
                    <th>Pesan</th>
                    <th>Layanan</th>
                  </tr>
                </thead>
                <tbody>
                  <% stats.chatTerbaru.forEach(chat=> { %>
                    <tr>
                      <td>
                        <%= new Date(chat.waktu).toLocaleString('id-ID') %>
                      </td>
                      <td>
                        <%= chat.nomor_wa.replace('@s.whatsapp.net', '' ) %>
                      </td>
                      <td class="text-truncate">
                        <%= chat.pesan_masuk %>
                      </td>
                      <td>
                        <% if (chat.layanan_nama) { %>
                          <span class="badge">
                            <%= chat.layanan_nama %>
                          </span>
                          <% } else { %>
                            <span class="text-muted">-</span>
                            <% } %>
                      </td>
                    </tr>
                    <% }); %>
                </tbody>
              </table>
              <div class="text-center">
                <a href="/riwayat" class="btn btn-secondary">Lihat Semua Riwayat</a>
              </div>
              <% } else { %>
                <p class="text-muted">Belum ada percakapan.</p>
                <% } %>
          </div>
        </div>
      </main>

      <footer class="footer">
        <div class="container">
          <p>&copy; 2026 Chatbot Administrasi Desa. All rights reserved.</p>
        </div>
      </footer>

      <!-- Notifikasi live chat: muncul saat ada sesi baru (fitur 98) -->
      <script>
        (function () {
          // Kumpulan ID sesi yang sudah dilihat/ditutup admin (per browser)
          const KEY = 'livechatDismissedIds';
          let dismissed = new Set();
          try {
            dismissed = new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));
          } catch (e) { dismissed = new Set(); }
          let shownBannerId = null;

          const container = document.getElementById('livechatNotifContainer');
          if (!container) return;

          function simpanDismissed() {
            try {
              localStorage.setItem(KEY, JSON.stringify([...dismissed]));
            } catch (e) { /* abaikan */ }
          }

          async function cekSesiBaru() {
            try {
              const res = await fetch('/api/live-chat', { credentials: 'include' });
              if (res.status === 401) return; // belum login
              const data = await res.json();
              const aktif = (data.sesiList || []).filter(s => s.status === 'aktif');

              // Sesi aktif yang belum dilihat → tampilkan banner
              const baru = aktif.find(s => !dismissed.has(String(s.id)));

              if (baru && shownBannerId !== baru.id) {
                shownBannerId = baru.id;
                container.innerHTML = `
                  <div class="livechat-notif">
                    <div class="lc-notif-icon">🔔</div>
                    <div class="lc-notif-body">
                      <div class="lc-notif-title">Permintaan Live Chat Masuk!</div>
                      <div class="lc-notif-text">Pengguna +${baru.nomor_wa_bersih} meminta chat langsung dengan admin (fitur 98).</div>
                    </div>
                    <div class="lc-notif-actions">
                      <a class="btn-notif-buka" href="/live-chat">Buka</a>
                      <button class="btn-notif-tutup" title="Tutup" onclick="this.closest('.livechat-notif').remove(); dismissedAdd(${baru.id});">✕</button>
                    </div>
                  </div>
                `;
              }

              // Sesi aktif tidak ada lagi / sudah selesai → sembunyikan banner
              if (aktif.length === 0 && shownBannerId !== null) {
                shownBannerId = null;
                container.innerHTML = '';
              }
            } catch (e) {
              // abaikan, coba lagi nanti
            }
          }

          window.dismissedAdd = function (id) {
            dismissed.add(String(id));
            simpanDismissed();
          };

          // Cek setiap 5 detik
          cekSesiBaru();
          setInterval(cekSesiBaru, 5000);
        })();
      </script>
</body>

</html>